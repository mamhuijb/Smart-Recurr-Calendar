VITE_GEMINI_API_KEY=your_gemini_key_here
PORT=3000
NODE_ENV=development

# Syncro MSP Configuration
# Get your API key from Syncro MSP Admin Settings -> API Tokens
SYNCRO_API_KEY=
SYNCRO_SUBDOMAIN=your_subdomain

# Office 365 OAuth Configuration
# Register an app in Azure AD to get these
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_TENANT_ID=common
O365_REDIRECT_URI=http://localhost:3000/api/auth/callback
