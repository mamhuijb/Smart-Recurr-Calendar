# SmartRecur Calendar – LiteSpeed / Apache .htaccess
# Tested on Plesk + CloudLinux + LiteSpeed Enterprise + PHP 8.4

RewriteEngine On

# ─── Disable ModSecurity for API (Plesk/CloudLinux) ──────────
# ModSecurity often blocks PUT/DELETE/PATCH methods with 403.
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>
<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>

# ─── API routing ─────────────────────────────────────────────
# All /api/* requests go to the PHP router (all HTTP methods)
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# ─── Serve built frontend from dist/ ─────────────────────────
# Vite outputs to dist/ — map root requests to dist/ files.
# /assets/xxx.js  →  dist/assets/xxx.js
# /index.html     →  dist/index.html
RewriteCond %{DOCUMENT_ROOT}/dist%{REQUEST_URI} -f
RewriteRule ^(.+)$ dist/$1 [L]

# ─── SPA fallback ────────────────────────────────────────────
# Everything else (non-file, non-dir, non-api) → dist/index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ dist/index.html [L]

# ─── Security headers ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ─── Static asset caching ────────────────────────────────────
# Vite hashes filenames, so we can cache aggressively
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ─── Compression ─────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── Block access to sensitive files ─────────────────────────
<FilesMatch "\.(env|sql|lock|log|sh|yml|yaml|ini|bak)$">
    Require all denied
</FilesMatch>

# Block hidden files/dirs (except .htaccess and .well-known)
RewriteRule (^|/)\.(?!htaccess|well-known) - [F]

# Block direct access to source/config directories
RewriteRule ^(database|node_modules|components|services|utils)/ - [F]
