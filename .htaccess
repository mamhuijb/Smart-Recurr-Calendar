# SmartRecur Calendar – LiteSpeed / Apache .htaccess
# Tested on Plesk + CloudLinux + LiteSpeed Enterprise + PHP 8.4

RewriteEngine On

# ─── Disable ModSecurity for API (Plesk/CloudLinux) ──────────
# ModSecurity often blocks PUT/DELETE/PATCH methods with 403.
<IfModule mod_security2.c>
    SecRuleEngine Off
</IfModule>
<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>

# ─── Default document ──────────────────────────────────────────
# Serve app.html (production build) instead of index.html (dev template)
DirectoryIndex app.html

# ─── API routing ─────────────────────────────────────────────
# All /api/* requests go to the PHP router (all HTTP methods)
# [END] (not [L]) stops all rewrite processing — prevents LiteSpeed context issues
RewriteRule ^api/(.*)$ api/index.php [QSA,END]

# ─── Block dev template ─────────────────────────────────────────
# Redirect index.html to app.html (index.html is the Vite dev template)
RewriteRule ^index\.html$ app.html [L,R=302]

# ─── SPA fallback ────────────────────────────────────────────
# Non-file, non-dir, non-api requests → app.html (production SPA entry)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ app.html [L]

# ─── Security headers ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ─── Static asset caching ────────────────────────────────────
# Vite hashes filenames, so we can cache aggressively
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ─── Compression ─────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── Block access to sensitive files ─────────────────────────
<FilesMatch "\.(env|sql|lock|log|sh|yml|yaml|ini|bak)$">
    Require all denied
</FilesMatch>

# Block hidden files/dirs (except .htaccess and .well-known)
RewriteRule (^|/)\.(?!htaccess|well-known) - [F]

# Block direct access to source/config directories
RewriteRule ^(database|node_modules|components|services|utils|dist|src)/ - [F]
