# SmartRecur Calendar – LiteSpeed / Apache .htaccess
# Tested on Plesk + CloudLinux + LiteSpeed Enterprise + PHP 8.4

RewriteEngine On

# ─── API routing ─────────────────────────────────────────────
# All /api/* requests go to the PHP router (all HTTP methods)
RewriteCond %{REQUEST_URI} ^/api/
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# ─── Static frontend assets from dist/ ──────────────────────
# If a file exists inside dist/, serve it directly
RewriteCond %{DOCUMENT_ROOT}/dist/%{REQUEST_URI} -f
RewriteRule ^(.*)$ dist/$1 [L]

# ─── SPA fallback ────────────────────────────────────────────
# Everything else goes to dist/index.html (React Router)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ dist/index.html [L]

# ─── Security headers ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

# ─── Static asset caching ────────────────────────────────────
# Vite hashes filenames, so we can cache aggressively
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ─── Compression ─────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── Block access to sensitive files ─────────────────────────
# Note: API routes are already handled by RewriteRule above (L flag),
# so this only applies to direct file access outside the API.
<FilesMatch "\.(env|sql|md|lock|log|sh|yml|yaml|ini|bak|dist)$">
    Require all denied
</FilesMatch>

# Block hidden files/dirs (except .htaccess and .well-known)
RewriteRule (^|/)\.(?!htaccess|well-known) - [F]

# Block direct PHP access in subdirectories
RewriteRule ^(database|node_modules|components|services|utils)/ - [F]
