# App Debug – set to true to see detailed error messages in API responses
# IMPORTANT: Set to false in production!
APP_DEBUG=true

# Database (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartrecur
DB_USER=smartrecur
DB_PASS=your_db_password

# JWT Secret – generate a strong random string (min 32 chars)
# Example: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_STRING_AT_LEAST_32_CHARS
JWT_EXPIRY=86400

# CORS – set to your frontend domain in production
CORS_ORIGIN=https://your-domain.com

# Timezone for cron jobs and date calculations
TIMEZONE=Europe/Amsterdam

# Office 365 OAuth Configuration
# Register an app at https://portal.azure.com → App Registrations
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_TENANT_ID=common
O365_REDIRECT_URI=https://your-domain.com/api/integrations/office365/callback

# Cron secret for automated reminder emails
# Generate with: openssl rand -hex 16
CRON_SECRET=

# Syncro MSP Configuration
# Get your API key from Syncro MSP Admin → API Tokens
SYNCRO_API_KEY=
SYNCRO_SUBDOMAIN=your_subdomain
